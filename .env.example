ASE_APP_NAME="Autonomous Software Engineering Multi-Agent System"
ASE_ENVIRONMENT=development
ASE_LOG_LEVEL=INFO
ASE_WORKSPACE_ROOT=.workspaces
# Set this to a locally pulled Ollama model tag to enable draft planning.
# ASE_OLLAMA_MODEL=qwen2.5-coder:3b
ASE_OLLAMA_BASE_URL=http://127.0.0.1:11434
ASE_PLANNER_TIMEOUT_SECONDS=180
ASE_TEST_TIMEOUT_SECONDS=60
ASE_DATABASE_URL=sqlite:///engineering.db
# PostgreSQL alternative after docker compose up -d postgres:
# ASE_DATABASE_URL=postgresql+psycopg://engineering:local-development-only@127.0.0.1:55432/engineering
ASE_REPOSITORY_ROOT=.
ASE_TEST_BACKEND=docker
ASE_TEST_FRAMEWORK=unittest
ASE_DOCKER_IMAGE=ase-runner:local
ASE_DOCKER_EXECUTABLE=docker
ASE_WORKER_POLL_SECONDS=1
ASE_LEASE_SECONDS=60
# Optional GitHub token; repository Contents and Pull requests write permissions
# are needed for explicit draft PR delivery. Never commit this token.
# ASE_GITHUB_TOKEN=
