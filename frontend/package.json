{
  "name": "engineering-lab-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "test": "node tests/run.cjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "dev:showcase": "vite --mode showcase --host 127.0.0.1 --port 5174 --strictPort",
    "build:showcase": "tsc -b && vite build --mode showcase",
    "preview:showcase": "vite preview --mode showcase --host 127.0.0.1 --port 4174 --strictPort",
    "deploy:showcase": "pnpm build:showcase && wrangler deploy",
    "check:cloudflare": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "prismjs": "1.30.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/prismjs": "1.26.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "wrangler": "^4.156.0"
  }
}
