ASE_APP_NAME="Autonomous Software Engineering Multi-Agent System"
ASE_ENVIRONMENT=development
ASE_LOG_LEVEL=INFO
ASE_WORKSPACE_ROOT=.workspaces
# New intended route: NVIDIA NIM / Kimi K3, with local Ollama fallback.
# Uncomment the route and set your key on the backend only; never commit it.
# ASE_MODEL_PRIMARY_PROVIDER=nvidia
# ASE_MODEL_PRIMARY_MODEL=moonshotai/kimi-k3
# ASE_NVIDIA_API_KEY=your-key-here
ASE_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Hosted K3 does not document response_format; schema instructions + local validation.
ASE_NVIDIA_STRUCTURED_MODE=prompt
ASE_MODEL_FALLBACK_ENABLED=true
# Environment routing supports Ollama fallback. Saved UI routing supports all protocols.
ASE_MODEL_FALLBACK_PROVIDER=ollama
# Optional override; otherwise uses ASE_OLLAMA_MODEL.
# ASE_MODEL_FALLBACK_MODEL=qwen2.5-coder:3b
# Without explicit routing or NVIDIA key, this preserves local-only compatibility.
# ASE_OLLAMA_MODEL=qwen2.5-coder:3b
ASE_OLLAMA_BASE_URL=http://127.0.0.1:11434
ASE_PLANNER_TIMEOUT_SECONDS=180
ASE_TEST_TIMEOUT_SECONDS=60
ASE_DATABASE_URL=sqlite:///engineering.db
# PostgreSQL alternative after docker compose up -d postgres:
# ASE_DATABASE_URL=postgresql+psycopg://engineering:local-development-only@127.0.0.1:55432/engineering
ASE_REPOSITORY_ROOT=.
ASE_TEST_BACKEND=docker
ASE_TEST_FRAMEWORK=unittest
ASE_DOCKER_IMAGE=ase-runner:local
ASE_DOCKER_EXECUTABLE=docker
ASE_WORKER_POLL_SECONDS=1
ASE_LEASE_SECONDS=60
# Separate local preview lifecycle service; images are built explicitly.
ASE_PREVIEW_PYTHON_IMAGE=codeops-preview-python:local
ASE_PREVIEW_NODE_IMAGE=codeops-preview-node:local
ASE_MAX_ACTIVE_PREVIEWS=3
ASE_PREVIEW_POLL_SECONDS=2
# Optional GitHub token; repository Contents and Pull requests write permissions
# are needed for explicit draft PR delivery. Never commit this token.
# ASE_GITHUB_TOKEN=

# Optional: prevent UI edits and force environment routing.
ASE_MODEL_SETTINGS_LOCKED=false
# Optional deployment secret: a Fernet key used to encrypt saved provider keys.
# Otherwise an ignored local key is generated (Windows: protected by user DPAPI).
# ASE_MODEL_SETTINGS_ENCRYPTION_KEY=your-fernet-key
